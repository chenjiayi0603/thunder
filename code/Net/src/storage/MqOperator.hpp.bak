#ifndef CLIENT_MQOPERATOR_HPP_
#define CLIENT_MQOPERATOR_HPP_

#include "StorageOperator.hpp"

namespace net
{

/**
 * @brief Mq请求协议生成器
 * @note 存储请求协议生成，用于同时单独请求Mq的场景。
 */
class MqOperator : public StorageOperator
{
public:
    /**
     * @brief 存储请求协议生成
     * @note 存储请求协议生成，用于同时单独请求Mq的场景。
     */
    MqOperator(DataMem::MemOperate::MqOperate::E_QUERY_TYPE type);
    virtual ~MqOperator();

    virtual DataMem::MemOperate* MakeMemOperate();

    virtual bool AddPinelineCmd(const std::string &topic,const std::string &tag,const std::string &key,const std::string &body)
    {
    	DataMem::MemOperate::MqOperate::MSG msg;
    	msg.set_topic(topic);
    	msg.set_tag(tag);
    	msg.set_key(key);
    	msg.set_body(body);
		m_vecPinelineCmds.push_back(std::move(msg));
		return true;
    }
    std::vector<DataMem::MemOperate::MqOperate::MSG> m_vecPinelineCmds;
protected:
    DataMem::MemOperate::MqOperate* GetMqOperate()
    {
        return(m_pMqOperate);
    }

    void SetMqOperateNull()
    {
        m_pMqOperate = nullptr;
    }

private:
    DataMem::MemOperate* m_pMqMemRequest = nullptr;
    DataMem::MemOperate::MqOperate* m_pMqOperate = nullptr;
};

} /* namespace net */

#endif /* CLIENT_MQOPERATOR_HPP_ */
