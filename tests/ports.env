# Thunder 服务端口 — 单一来源
# 对应 deploy/*/conf/*.json 中的 access_port
# 所有测试、deploy.sh、C++ smoke 均从此读取

THUNDER_HELLO_HTTP_PORT=27006
THUNDER_HELLO_HTTP_INNER_PORT=27007
THUNDER_INTERFACE_PORT=27008
THUNDER_INTERFACE_INNER_PORT=27009
THUNDER_HELLO_HTTPS_PORT=27043
THUNDER_HELLO_WS_PORT=27010
THUNDER_HELLO_WS_INNER_PORT=27011

# etcd 端口
THUNDER_ETCD_PORT=2379

# 端口说明：
# access_port  = 对外服务端口（HTTP 请求、测试连接这里）
# inner_port   = Manager↔Worker 内部通信端口（不对外，测试不要用）
# 16068        = Manager 管理端口（docker-compose healthcheck 检查的是这个，不是 HTTP 服务）
