{
    "node_type": "HELLO_HTTP",
    "access_host": "0.0.0.0",
    "access_port": 27006,
    "access_codec": 3,
    "inner_host": "0.0.0.0",
    "inner_port": 27007,
    "center": {
        "connector": "etcd-grpc",
        "etcd_endpoints": "http://127.0.0.1:12379"
    },
    "server_name": "Hello_robot",
    "process_num": "1",
    "worker_capacity": 1000000,
    "config_path": "conf/",
    "log_path": "log/",
    "max_log_file_num": 10,
    "max_log_file_size": 20480000,
    "permission": {
        "addr_permit": {
            "stat_interval": 1.0,
            "permit_num": 500
        },
        "uin_permit": {
            "stat_interval": 1.0,
            "permit_num": 500
        }
    },
    "io_timeout": 300.0,
    "step_timeout": 5.0,
    "log_level": "INFO",
    "load_so_interval": 60.0,
    "so": [],
    "io_backend": "ev",
    "https": {
        "server_cert": "/home/tommychen/thunder/deploy/HelloHttp/conf/certs/server.crt",
        "server_key": "/home/tommychen/thunder/deploy/HelloHttp/conf/certs/server.key",
        "verify_client": false
    },
    "module": [
        {
            "url_path": "/hello/hello",
            "so_path": "plugins/HelloHttp_ModuleHello.so",
            "entrance_symbol": "create",
            "load": true,
            "version": 6
        },
        {
            "url_path": "/hello/lua_echo",
            "so_path": "plugins/HelloHttp_ModuleLua.so",
            "entrance_symbol": "create",
            "load": true,
            "version": 12,
            "script_content": "function handle_request(msg)\n  local body = '{\"genkey\":\"1\",\"token\":\"canary_test_token\",\"key\":\"canary_test_key\",\"address\":\"192.168.3.61\"}'\n  local function on_response(resp_body)\n    -- 直接返回 Logic 的响应给客户端（不通过 SendToClientFast，避免双重发送）\n    return resp_body\n  end\n  local ok = SendToNodeType(\"LOGIC\", 10001, body, 5, on_response)\n  if not ok then\n    return false -- 让框架返回 500\n  end\n  return true\nend\n"
        },
        {
            "url_path": "/hello/raw",
            "so_path": "plugins/HelloHttp_ModuleRaw.so",
            "entrance_symbol": "create",
            "load": true,
            "version": 1
        }
    ]
}