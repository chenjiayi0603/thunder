{
  "node_type": "HELLO_HTTP",
  "access_host": "0.0.0.0",
  "access_port": 27006,
  "access_codec": 3,
  "inner_host": "0.0.0.0",
  "inner_port": 27007,
  "center": {
    "connector": "etcd",
    "etcd_endpoints": "http://127.0.0.1:2379"
  },
  "server_name": "Hello_robot",
  "process_num": "1",
  "worker_capacity": 1000000,
  "config_path": "conf/",
  "log_path": "log/",
  "max_log_file_num": 10,
  "max_log_file_size": 20480000,
  "permission": {
    "addr_permit": {
      "stat_interval": 1.0,
      "permit_num": 500
    },
    "uin_permit": {
      "stat_interval": 1.0,
      "permit_num": 500
    }
  },
  "io_timeout": 300.0,
  "step_timeout": 5.0,
  "log_level": "INFO",
  "load_so_interval": 60.0,
  "so": [],
  "module": [
    {
      "url_path": "/hello/hello",
      "so_path": "plugins/HelloHttp_ModuleHello.so",
      "entrance_symbol": "create",
      "load": true,
      "version": 1
    },
    {
      "url_path": "/hello/raw",
      "so_path": "plugins/HelloHttp_ModuleRaw.so",
      "entrance_symbol": "create",
      "load": true,
      "version": 1
    },
    {
      "url_path": "/hello/lua_echo",
      "script_path": "scripts/echo.lua",
      "entrance_symbol": "create_echo",
      "load": true,
      "version": 1,
      "so_path": "plugins/HelloHttp_ModuleLua.so"
    },
    {
      "url_path": "/hello/lua_route",
      "so_path": "plugins/HelloHttp_ModuleLua.so",
      "entrance_symbol": "create_route",
      "load": true,
      "version": 1
    },
    {
      "url_path": "/hello/lua_limit",
      "so_path": "plugins/HelloHttp_ModuleLua.so",
      "entrance_symbol": "create_limit",
      "load": true,
      "version": 1
    }
  ],
  "io_backend": "asio_uring",
  "https": {
    "server_cert": "/home/tommychen/thunder/deploy/HelloHttp/conf/certs/server.crt",
    "server_key": "/home/tommychen/thunder/deploy/HelloHttp/conf/certs/server.key",
    "verify_client": false
  },
  "dpdk": {
    "_comment": "DPDK + F-Stack \u7528\u6237\u6001 TCP \u914d\u7f6e (\u9700\u8981\u7f16\u8bd1 THUNDER_IO_DPDK=ON)",
    "eal_args": "--no-pci -l 0 -n 1",
    "vdevs": [
      "net_af_packet0,iface=lo"
    ],
    "pmd_plugins": [
      "dpdk/pmds-26.0/librte_mempool_ring.so",
      "dpdk/pmds-26.0/librte_net_af_packet.so"
    ],
    "port_id": 0,
    "lcore_id": 0,
    "max_concurrency": 100000,
    "rcv_buf_size": 8192,
    "snd_buf_size": 8192,
    "tcp_timeout": 30
  }
}
