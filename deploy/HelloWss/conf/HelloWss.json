{
    "node_type": "HELLO_WSS",
    "access_host": "0.0.0.0",
    "access_port": 27012,
    "access_codec": 12,
    "inner_host": "0.0.0.0",
    "inner_port": 27013,
    "center": {
        "connector": "etcd-grpc",
        "etcd_endpoints": "http://127.0.0.1:12379"
    },
    "server_name": "Hello_wss_robot",
    "process_num": 1,
    "worker_capacity": 1000000,
    "config_path": "conf/",
    "log_path": "log/",
    "max_log_file_num": 10,
    "max_log_file_size": 20480000,
    "permission": {
        "addr_permit": {
            "stat_interval": 1.0,
            "permit_num": 500
        },
        "uin_permit": {
            "stat_interval": 1.0,
            "permit_num": 500
        }
    },
    "io_timeout": 300.0,
    "step_timeout": 5.0,
    "log_level": "INFO",
    "load_so_interval": 60.0,
    "so": [
        {
            "cmd": 20001,
            "so_path": "plugins/HelloWs_CmdHello.so",
            "entrance_symbol": "create",
            "process_num": 0,
            "load": true,
            "version": 1
        }
    ],
    "io_backend": "ev",
    "module": [
        {
            "url_path": "/hello/shake",
            "so_path": "plugins/HelloWs_ModuleShake.so",
            "entrance_symbol": "create",
            "load": true,
            "version": 1
        }
    ],
    "https": {
        "server_cert": "conf/certs/server.crt",
        "server_key": "conf/certs/server.key",
        "verify_client": false
    }
}