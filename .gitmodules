# 第三方子模块：可复现构建以父仓库 gitlink 为准；克隆: git submodule update --init --recursive
#
# 下表与父仓库「当前分支最后一次提交」HEAD 中的 gitlink 一致（与 GitHub/GitLab 网页上 code/3party 下列出的短 SHA 同源）。
# branch 为该提交的远端可解析引用：与 HEAD 一致时优先 tag；若 tag 已前移、不再指向本提交，则必须用完整 object id。
# 若 fetch 失败：子模块目录内 git fetch origin <下方 branch 列>
#
# 库                 短SHA   版本/分支说明（git describe）              branch（=.gitmodules，与 HEAD gitlink 同提交）
# asio               bd500f0 asio-1-38-0-18-gbd500f0a0（standalone）   bd500f0a018db9a845ebaaed5c0318343ae9f497
# c-ares             2870f6b v1.31.0-327-g2870f6b1                    2870f6b14723b3bb77a365f4745abcbd74c2ffad
# cryptopp           b524266 CRYPTOPP_8_9_0-23-gb5242667               b5242667a24e3db8e4600e77b2e502ef204e5280
# curl               2b3438d curl-8_19_0-26-g2b3438d486                2b3438d486982b5b22c001ab2c601837e83b4787
# hiredis-vip        f120604 0.3.0-4-gf120604                         f12060498004494a3e1de11f653a8624f3d218c3
# libev              93823e6 上游无 tag（master 线快照）                93823e6ca699df195a6c7b8bfa6006ec40ee0003
# log4cplus          505a61e REL_2_0_2-462-g505a61e8                   505a61e814ece740ce6a116d72f2091a37f472a6
# mariadb-connector-c 532350d v3.4.8-15-g532350d8                       532350d8fc56c7783085d7a4f7747737883f84f7
# mongo-c-driver     e97ed96 1.11.0-2340-ge97ed96e1d                   e97ed96e1d1c96ca57cfa0639a42798a67c71836
# protobuf           eaec88f v33-dev-1017-geaec88fea                   eaec88fea0b95468f293f89bd08e5a0e5ab8490b
# etcd-cpp-apiv3     7c6e714 post-v0.15.4 (GPR_ASSERT + uint64_t fix)    7c6e714f188f9576e25e0350cac4181139eec23e
# grpc               e84a8a2 v1.81.1                                    e84a8a2f04095f2772ba42a4abccde4f9243e75b
#
[submodule "code/3party/libev"]
	path = code/3party/libev
	url = https://github.com/enki/libev.git
	branch = 93823e6ca699df195a6c7b8bfa6006ec40ee0003
[submodule "code/3party/hiredis-vip"]
	path = code/3party/hiredis-vip
	url = https://github.com/vipshop/hiredis-vip.git
	branch = f12060498004494a3e1de11f653a8624f3d218c3
[submodule "code/3party/cryptopp"]
	path = code/3party/cryptopp
	url = https://github.com/weidai11/cryptopp.git
	branch = b5242667a24e3db8e4600e77b2e502ef204e5280
[submodule "code/3party/mongo-c-driver"]
	path = code/3party/mongo-c-driver
	url = https://github.com/mongodb/mongo-c-driver.git
	branch = e97ed96e1d1c96ca57cfa0639a42798a67c71836
[submodule "code/3party/mariadb-connector-c"]
	path = code/3party/mariadb-connector-c
	url = https://github.com/mariadb-corporation/mariadb-connector-c.git
	branch = 532350d8fc56c7783085d7a4f7747737883f84f7
[submodule "code/3party/curl"]
	path = code/3party/curl
	url = https://github.com/curl/curl.git
	branch = 2b3438d486982b5b22c001ab2c601837e83b4787
[submodule "code/3party/c-ares"]
	path = code/3party/c-ares
	url = https://github.com/c-ares/c-ares.git
	branch = 2870f6b14723b3bb77a365f4745abcbd74c2ffad
[submodule "code/3party/protobuf"]
	path = code/3party/protobuf
	url = https://github.com/protocolbuffers/protobuf.git
	branch = b6f9284da830b69be787732ffdaa35049d20a088
[submodule "code/3party/log4cplus"]
	path = code/3party/log4cplus
	url = https://github.com/log4cplus/log4cplus.git
	branch = 505a61e814ece740ce6a116d72f2091a37f472a6
[submodule "code/3party/asio"]
	path = code/3party/asio
	url = https://github.com/chriskohlhoff/asio.git
	branch = bd500f0a018db9a845ebaaed5c0318343ae9f497
[submodule "code/3party/etcd-cpp-apiv3"]
